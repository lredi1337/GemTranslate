<?xml version="1.0" encoding="utf-8"?>
<!-- Долгое нажатие на иконку → «Настройки» -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="setup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_setup">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.aitranslator.launcher"
            android:targetClass="app.aitranslator.launcher.SetupActivity" />
    </shortcut>
</shortcuts>
