<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмная тема без панели: страница сразу на тёмном фоне, без белой вспышки при запуске -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
